# LLM配置 (vLLM on AutoDL)
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=empty
LLM_MODEL=Qwen2.5-7B-Instruct

# 知识图谱
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=scenic2024

# 向量数据库
CHROMA_HOST=localhost
CHROMA_PORT=8001

# 高德地图API（免费申请：https://lbs.amap.com/）
AMAP_API_KEY=

# 服务端口
PORT=8088

# 开发模式（mock=True时不调用真实LLM，返回预设响应）
DEV_MOCK_LLM=false

# 访问认证（公网部署时设置，留空则不启用。用户需带?key=xxx访问）
ACCESS_KEY=

# AutoDL自动管理配置
AUTODL_API_TOKEN=           # 开发者Token（控制台→设置→开发者Token，需实名认证）
AUTODL_INSTANCE_ID=         # 实例UUID（如 f6454295d3-1db02697）
AUTODL_SSH_HOST=            # SSH主机（如 connect.bjb1.seetacloud.com）
AUTODL_SSH_PORT=            # SSH端口（如 49122）
AUTODL_SSH_PASSWORD=        # SSH密码
AUTODL_PUBLIC_URL=          # AutoDL 6006端口HTTPS映射地址（如 https://u1-xxx.seetacloud.com:8443）
AUTODL_BALANCE_THRESHOLD=5  # 余额不足阈值（元），低于此值禁止开机
AUTODL_IDLE_TIMEOUT=600     # 空闲自动关机秒数（默认10分钟）
